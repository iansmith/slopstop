# .project-conf.toml — slopstop per-project configuration
#
# Copy this file to .project-conf.toml in your repo root and fill in the values.
# This file is COMMITTED to git — it is shared with everyone who clones the project.
# Do NOT put credentials here; those go in ~/.slopstop/ (see CONFIG.md).
#
# Full reference: CONFIG.md in this repo.
# First-time setup: design/cold-start.md §7.

# ---------------------------------------------------------------------------
# Required — ticket system
# ---------------------------------------------------------------------------

system = "github"          # "github" | "linear" | "jira"
key    = "owner/repo"      # GitHub:  "owner/repo" (e.g. "iansmith/slopstop")
                           # Linear:  team key    (e.g. "MAZ")
                           # JIRA:    project key (e.g. "PLTF")
prefix = "BILL"            # Ticket prefix — BILL-NN; matches key for Linear/JIRA

# ---------------------------------------------------------------------------
# Optional — tracking-file location (OVERRIDES; you probably need neither)
# ---------------------------------------------------------------------------

# Where per-ticket tracking dirs (task_plan/findings/progress) live, and where
# :archive moves them at end of life. Resolved in three tiers, first match wins,
# both paths together:
#
#   1. the key below, verbatim
#   2. key unset + a .slopstop/ dir at the main worktree root
#        -> .slopstop/ticket-active and .slopstop/ticket-archive
#   3. key unset + no .slopstop/  -> ~/.claude/ticket-{active,archive} (legacy)
#
# Tier 2 is what you want, and it needs NO config — just the directory (:gh-init
# and :design create and gitignore it for you). Leave both keys commented out.
#
# Tier 3 is a trap: ~/.claude is a protected path, and a headless fleet agent's
# Write tool refuses it even when the launch passes a matching --add-dir. An agent
# that cannot write its tracking dir invents a local one and drifts. The fix is to
# create .slopstop/ (tier 2) — a DIRECTORY, not a key.
#
# Relative paths resolve from the MAIN worktree root (not cwd), so every linked
# worktree shares one pair of dirs — no symlinking.
#
# Uncomment ONLY to point somewhere other than .slopstop/ — e.g. off-repo state.
# Note the example is deliberately NOT ".slopstop/ticket-active": that value is what
# tier 2 already gives you, and writing it here is how a session with a configured
# .slopstop learned to append "ticket-active" to it and invent a second tree.
# tracking_dir = "/Volumes/work/slopstop-state/ticket-active"
# archive_dir  = "/Volumes/work/slopstop-state/ticket-archive"

# ---------------------------------------------------------------------------
# Optional — remote names (both default to "origin" when absent)
# ---------------------------------------------------------------------------

# pr-remote — remote to push feature branches to before opening a PR
# Set to your personal fork remote when using a fork-based workflow.
# pr-remote     = "origin"

# origin-remote — the canonical/blessed remote
# :start uses it as base for new branches; :merge fetches and pulls from it.
# origin-remote = "origin"

# ---------------------------------------------------------------------------
# [status_labels] — GitHub Issues workflow shape
# GitHub only; ignored for Linear and JIRA.
# ---------------------------------------------------------------------------

[status_labels]
in_progress = "status:in-progress"   # Required — label applied when a ticket starts
# in_review  = "status:in-review"   # Uncomment to enable 4-state workflow

# ---------------------------------------------------------------------------
# [pr_review] — PR review backend (optional; omit to use CodeRabbit default)
# ---------------------------------------------------------------------------

[pr_review]
backend = "claude"    # "coderabbit" (default) | "claude"
effort  = "high"      # low | medium | high | xhigh | max  (Claude only)

# ---------------------------------------------------------------------------
# [design] — the authoritative specification (optional)
#
# Names the document(s) :design treats as the source of truth. Every PRD decision
# is then classified against it (SPEC / DERIVED / UNDERDETERMINED), and the
# ticket-tree adversary's check F re-reads it to verify each quoted excerpt still
# says what the decision claims.
#
# Resolution: `:design --spec <path>` (repeatable) > this key > a conventional
# path (SPEC.md, docs/spec*.md), which :design proposes and asks about rather
# than adopting silently. If none resolves, the PRD records
# `SPEC: none — greenfield`.
# ---------------------------------------------------------------------------
# [design]
#
# PICK ONE FORM — `spec` is a single key. Uncommenting both lines is a TOML
# duplicate-key error, not a merge.
#
# spec = "SPEC.md"                             # one document, or
# spec = ["SPEC.md", "docs/api-contract.md"]   # several

# ---------------------------------------------------------------------------
# [workflow] — reduce interactive confirmation friction (optional)
# ---------------------------------------------------------------------------

[workflow]
# After a merge, take the ticket straight to its terminal state (the default).
# Set false when merged code still needs human verification before it is really done —
# e.g. on-device mobile testing after an Expo/EAS build — so the ticket advances one
# state and waits for a person to finish it.
# post_merge_done = true

skip_confirm = false   # true: auto-confirm :merge/:archive/:start prompts

# ---------------------------------------------------------------------------
# [tiers] — model tier assignments for the four-tier slopstop process (optional)
# Used by the stage skills: :design runs on `huge`, :tickets on `large`, :run on
# `medium`, fleet implementation agents on `small` (see [fleet.agents]). Stage skills
# hard-stop on a session-model mismatch. Every tier check/adversary spawns at the tier
# named here (checker = one tier above the doer). Missing table -> these defaults.
# ---------------------------------------------------------------------------

[tiers]
[tiers.huge]
provider = "anthropic"
model    = "fable"
# version  = ""  # optional: pin to a specific model version
# effort   = "high"    # low | medium | high | xhigh | max  (default: "inherit" — no effort passed)

[tiers.large]
provider = "anthropic"
model    = "opus"
# effort   = "high"    # low | medium | high | xhigh | max  (default: "inherit")

[tiers.medium]
provider = "anthropic"
model    = "sonnet"
# effort   = "medium"  # low | medium | high | xhigh | max  (default: "inherit")

[tiers.small]
provider = "anthropic"
model    = "haiku"
# effort   = "medium"  # low | medium | high | xhigh | max  (default: "inherit")


# ---------------------------------------------------------------------------
# [stage_tiers] — process structure: which TIER each stage and check runs at
# (optional). [tiers] maps tier -> model; [stage_tiers] maps stage/check -> tier.
# Resolution is two hops: stage -> tier -> model
# (e.g. stage_tiers.design = "huge" -> tiers.huge = "fable"). Re-tiering a stage
# is a one-line edit here — no skill rewrite. Missing table or key -> these
# defaults (the settled "checker one tier above the doer" ladder).
# ---------------------------------------------------------------------------

[stage_tiers]
# Stages
design              = "huge"     # :design tier gate
tickets             = "large"    # :tickets tier gate
# Checks — checker = one tier above the doer
ticket_adversary    = "huge"     # checks the large tier's ticket tree
rewrite_delta_check = "huge"     # checks a large-tier rewrite before relaunch
drift_check         = "large"    # checks the integrated code at umbrella completion
handoff_verifier    = "medium"   # checks the small tier's per-leaf implementation
report_adversary    = "huge"     # checks the final report

# [fleet.agents], [fleet.monitoring], [fleet.budget] and [fleet.router] were REMOVED
# in v4.0.0. They configured the fleet launcher -- headless `claude -p` processes, a
# polling monitor, attempt caps, and the metering router. :run still drives many
# tickets at once, but it launches worker agents, so there is no launch model, poll
# interval, tool grant or router URL to configure. Delete them if your file has them.

[complexity]




# :pr — cyclomatic complexity gate (Step 0c). Inclusive lower bounds:
# cc_warn_threshold <= CC < cc_reject_threshold warns; CC >= cc_reject_threshold rejects.
# cc_warn_threshold = 5             # 🟡 elevated boundary
# cc_reject_threshold = 10          # 🔴 hard-gate boundary

# Exempt a 🔴 CC violation the branch DID NOT MAKE WORSE (CC at base >= CC at head,
# measured by a second lizard run against a worktree at the base commit). A function
# the branch created or worsened is judged normally -- this is not a way past the gate.
# Exempt violations are still printed, ranked by CC descending, with a total, and feed
# `/slopstop:tickets --refactor <fn>...`. ON by default since BILL-468: the gate was
# forcing behaviour-preserving refactors into feature branches. Set false to make every
# 🔴 block regardless (this also skips the base measurement).
# cc_exempt_pre_existing = true
