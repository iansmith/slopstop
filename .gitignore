.DS_Store
*.swp
.idea/
.vscode/

# Python build / cache artifacts. Generated by pytest and the interpreter; never committed.
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Local dev virtualenv. Machine-local; never committed.
.venv/

# Never committed.
scratch/

# Project-local ticket tracking (tracking_dir = ".slopstop"). Holds the transient
# per-ticket task_plan/findings/progress dirs and their archive. Working state, not
# source — same treatment as scratch/.
.slopstop/

# Transient design/PRD scratch (docs/ is stale-fast working material, not source —
# design/ is the durable committed home). Tooling settings under .pi/ are machine-local.
docs/
.pi/

# Jekyll build output. site/ is the source; the rendered HTML is built in CI by
# .github/workflows/pages.yml and never committed. These only appear if someone
# previews the site locally.
_site/
site/_site/
.jekyll-cache/
site/.jekyll-cache/

# Staged into ./site by the pages workflow so Jekyll can render it — walkthrough/
# at the repo root is the source of truth. Never committed from here. Note this
# means a local `jekyll serve` shows the site's walkthrough links as broken while
# CI is fine; run the workflow's staging step by hand first if you need them.
site/walkthrough/
